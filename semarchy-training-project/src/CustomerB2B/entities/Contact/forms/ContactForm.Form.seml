_package: CustomerB2B.entities.Contact.forms
_type: Form
_name: ContactForm
entity: CustomerB2B.entities.Contact.Contact
default: true
formTabs:
  - _type: FormTab
    _name: Contact
    label: Contact
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: IdField
        _name: ContactID
        value: ContactID
        useCustomLabel: false
        dataType: LONG_INTEGER

      - _type: TextField
        _name: FirstName
        value: FirstName
        useCustomLabel: false
        dataType: STRING

      - _type: TextField
        _name: LastName
        value: LastName
        useCustomLabel: false
        dataType: STRING

      - _type: TextField
        _name: Email
        value: Email
        useCustomLabel: false
        dataType: STRING

      - _type: TextField
        _name: Phone
        value: Phone
        useCustomLabel: false
        dataType: STRING

      - _type: TextField
        _name: JobTitle
        value: JobTitle
        useCustomLabel: false
        dataType: STRING

      - _type: ReferenceField
        _name: FDN_Customer
        value: FDN_Customer
        useCustomLabel: false
        dataType: STRING
        referencedEntity: CustomerB2B.entities.Customer.Customer
