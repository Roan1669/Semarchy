_package: CustomerB2B.entities.Country.action_sets
_type: ActionSet
_name: CountryActionSet
entity: CustomerB2B.entities.Country.Country
label: Country Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorCountries
    label: Create
    useCustomLabel: true
    stepper: CustomerB2B.entities.Country.steppers.AuthorCountries
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorCountries
    label: Edit
    useCustomLabel: true
    stepper: CustomerB2B.entities.Country.steppers.AuthorCountries
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorCountries
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CustomerB2B.entities.Country.steppers.AuthorCountries
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
