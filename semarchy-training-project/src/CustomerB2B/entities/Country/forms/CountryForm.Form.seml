_package: CustomerB2B.entities.Country.forms
_type: Form
_name: CountryForm
entity: CustomerB2B.entities.Country.Country
default: true
formTabs:
  - _type: FormTab
    _name: Country
    label: Country
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: IdField
        _name: CountryCode
        value: CountryCode
        useCustomLabel: false
        dataType: STRING

      - _type: TextField
        _name: CountryName
        value: CountryName
        useCustomLabel: false
        dataType: STRING

      - _type: TextField
        _name: Region
        value: Region
        useCustomLabel: false
        dataType: STRING

      - _type: TextField
        _name: ISONumericCode
        value: ISONumericCode
        useCustomLabel: false
        dataType: STRING
