_package: CustomerB2C.entities.CommChanPref.collection_views
_type: CollectionView
_name: CommChanPrefCollection

default: true
entity: CustomerB2C.entities.CommChanPref.CommChanPref
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Communication Preferences
tableRowLines: 2
tableShowDisplayCard: true
displayCard: CustomerB2C.entities.CommChanPref.display_cards.CommChanPrefDisplayCard

tableColumns:
  - _type: MenuColumn
    _name: CommunicationType
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: CommunicationType
    visibleByDefault: true

  - _type: MenuColumn
    _name: ChannelFrequency
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: ChannelFrequency
    visibleByDefault: true

  - _type: MenuColumn
    _name: Preference
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Preference
    visibleByDefault: true

  - _type: TextColumn
    _name: FirstName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FirstName
    visibleByDefault: true
