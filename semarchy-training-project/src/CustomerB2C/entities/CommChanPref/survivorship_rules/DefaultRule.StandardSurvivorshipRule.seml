_package: CustomerB2C.entities.CommChanPref.survivorship_rules
_type: StandardSurvivorshipRule
_name: DefaultRule
label: Default Rule
consolidationSkipNulls: false
defaultRule: true
entity: CustomerB2C.entities.CommChanPref.CommChanPref
consolidationStrategy: PREFERRED_PUBLISHER
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
  - attributeName: ChannelFrequency
  - attributeName: CommunicationType
  - attributeName: FirstName
  - attributeName: Person
  - attributeName: Preference
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: CustomerB2C.publishers.Marketing
  - _type: ConsoPublisherRanking
    publisher: CustomerB2C.publishers.CRM
  - _type: ConsoPublisherRanking
    publisher: CustomerB2C.publishers.ERP
