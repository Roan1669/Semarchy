_package: CustomerB2C.entities.Person
_type: Entity
_name: Person
entityType: FUZZY_MATCHED
physicalTableName: PERSON
iconUrl: images://mdi/people.svg
label: Customer
pluralLabel: Customers
description: ''
documentation: ''
enableDelete: true
dataEntryAllowed: true
historizeGolden: true
historizeMaster: true
matcher:
  _type: SemQLMatcher
  _name: Person
  description: Strategies for matching customer and prospect data
  matchRules:
    - _name: NormalizedLastNameMemberID
      _type: SemQLMatchRule
      label: Normalized Last Name Member ID
      documentation: 'In the best case scenario, we match people with this rule: match
        on Name and Member ID across systems.'
      color: md:purple 900
      condition: /*** Last Name exact match ***/  Record1.NormalizedLastName = Record2.NormalizedLastName  /***
        Social Security Number exact match ***/ AND Record1.MemberID = Record2.MemberID
      matchScore: 100
    - _name: NormalizedNameOrNicknameDOBEmail
      _type: SemQLMatchRule
      label: Normalized Name Or Nickname DOB Email
      documentation: 'In the "Normal Ideal" case, we match people with this rule:
        match on Name, Date of Birth, and Email, across systems.'
      color: md:purple 700
      condition: /*** Normalized Name or nickname exact match ***/ ( Record1.NormalizedFirstName
        = Record2.NormalizedFirstName    OR Record1.Nickname = Record2.Nickname    OR
        Record1.NormalizedFirstName = Record2.Nickname    OR Record1.Nickname =  Record2.NormalizedFirstName
        )  AND Record1.NormalizedLastName = Record2.NormalizedLastName   /*** Date
        of birth exact match ***/ AND Record1.DateOfBirth = Record2.DateOfBirth  /***
        Email exact match ***/ AND Record1.CleansedEmail = Record2.CleansedEmail
      matchScore: 98
    - _name: NormalizedNameOrNicknameDOBPhone
      _type: SemQLMatchRule
      label: Normalized Name Or Nickname DOB Phone
      documentation: 'In this match case scenario, we match people with this rule:
        match on Name, Normalized Address, and Date of Birth across systems.'
      color: md:purple 400
      condition: /*** Normalized Name or nickname exact match ***/ ( Record1.NormalizedFirstName
        = Record2.NormalizedFirstName    OR Record1.Nickname = Record2.Nickname    OR
        Record1.NormalizedFirstName = Record2.Nickname    OR Record1.Nickname =  Record2.NormalizedFirstName
        )  AND Record1.NormalizedLastName = Record2.NormalizedLastName   /*** Date
        of birth exact match ***/ AND Record1.DateOfBirth = Record2.DateOfBirth  /***
        Address match ***/ AND Record1.StandardizedPhone = Record2.StandardizedPhone
      matchScore: 96
    - _name: NormalizedNameOrNicknameAddressEmailPhone
      _type: SemQLMatchRule
      label: Normalized Name Or Nickname Address Email Phone
      documentation: 'In this match case scenario, we match people with this rule:
        match on Name, Normalized Address, and Date of Birth across systems.'
      color: md:purple 400
      condition: /*** Normalized Name or nickname exact match ***/ ( Record1.NormalizedFirstName
        = Record2.NormalizedFirstName    OR Record1.Nickname = Record2.Nickname    OR
        Record1.NormalizedFirstName = Record2.Nickname    OR Record1.Nickname =  Record2.NormalizedFirstName
        )  AND Record1.NormalizedLastName = Record2.NormalizedLastName   /*** Address
        match ***/ AND Record1.NormalizedStreet = Record2.NormalizedStreet AND Record1.NormalizedCity
        = Record2.NormalizedCity AND Record1.NormalizedState = Record2.NormalizedState
        AND coalesce(Record1.Address.PostalCode, 'default') = coalesce(Record2.Address.PostalCode,
        'default') AND Record1.Address.Country = Record2.Address.Country  /*** Cleansed
        contact info ***/ AND Record1.StandardizedPhone = Record2.StandardizedPhone
        AND Record1.CleansedEmail = Record2.CleansedEmail
      matchScore: 94
    - _name: PhoneticNameAddressEmailPhone
      _type: SemQLMatchRule
      label: Phonetic Name Address Email Phone
      color: md:purple 200
      condition: /*** Phonetic Name match ***/ Record1.PhoneticFirstName = Record2.PhoneticFirstName
        AND Record1.PhoneticLastName = Record2.PhoneticLastName  /*** Address match
        ***/ AND         ((Record1.NormalizedStreet = Record2.NormalizedStreet AND
        Record1.NormalizedCity = Record2.NormalizedCity AND Record1.NormalizedState
        = Record2.NormalizedState AND coalesce(Record1.Address.PostalCode, 'default')
        = coalesce(Record2.Address.PostalCode, 'default') AND Record1.Address.Country
        = Record2.Address.Country )  /*** Cleansed contact info ***/ OR         (Record1.StandardizedPhone
        = Record2.StandardizedPhone AND Record1.CleansedEmail = Record2.CleansedEmail
        ))
      matchScore: 78
    - _name: ExactEmailMatch
      _type: SemQLMatchRule
      label: Exact Email Match
      documentation: We match people based on the same Email, across systems.
      description: Email is a strong match because most customers have a unique email
        But it could be share in a family situation so it's a useful suggestion.
      color: md:purple 100
      condition: Record1.CleansedEmail = Record2.CleansedEmail
      matchScore: 68
    - _name: SimilarLastNameAddress
      _type: SemQLMatchRule
      label: Similar Name Address
      documentation: Fuzzy matching rule to catch typos with name and address data
        entry
      color: md:purple 100
      condition: /*** Matching on similar names, catching typos ***/ Record1.NormalizedFirstName
        = Record2.NormalizedFirstName AND SEM_EDIT_DISTANCE_SIMILARITY( Record1.NormalizedLastName,
        Record2.NormalizedLastName ) > 80   /*** Match on similar address ***/ AND  SEM_EDIT_DISTANCE_SIMILARITY(
        Record1.NormalizedStreet, Record2.NormalizedStreet )  > 75  /*** Exact match
        on city, zip code, state, and country ***/ AND Record1.NormalizedCity = Record2.NormalizedCity
        AND Record1.NormalizedState = Record2.NormalizedState AND coalesce(Record1.Address.PostalCode,
        'default') = coalesce(Record2.Address.PostalCode, 'default') AND Record1.Address.Country
        = Record2.Address.Country
      matchScore: 68
  useTransitiveMatchScore: true
  useMultiIterationGrouping: true
  mergeThresholdNewGroup: 85
  mergeThresholdMergingUnconfirmed: 85
  mergeThresholdMergingConfirmed: 85
  mergeThresholdMergingConfirmedWithUnconfirmed: 85
  mergeThresholdMergingUnconfirmedWithNewMasters: 85
  mergeThresholdMergingConfirmedWithNewMasters: 85
  mergeThresholdRemergingPreviouslySplit: 100
  autoConfirmGoldenThreshold: 95
  autoConfirmSingletons: false

attributes:
  - _name: ID
    _type: EntityAttribute
    label: ID
    description: ''
    documentation: ''
    physicalName: ID
    dataType: LongInteger
    precision: 38
    length: 0
    mandatory: true
    valueSeparator: ''
    searchable: true
  - _name: FirstName
    _type: EntityAttribute
    label: First Name
    description: ''
    documentation: A customer's given name–an informal name or nickname is commonly
      used
    dataType: String
    physicalName: FIRST_NAME
    mandatory: false
    mandatoryValidationLabel: ''
    valueSeparator: ','
    length: 128
  - _name: LastName
    _type: EntityAttribute
    label: Last Name
    description: ''
    documentation: A customer's surname
    dataType: String
    physicalName: LAST_NAME
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    mandatoryValidationLabel: ''
    valueSeparator: ','
    length: 128
  - _name: PhoneticFirstName
    _type: EntityAttribute
    label: Phonetic First Name
    description: ''
    documentation: First name transformed using the phonetic metaphone algorithm
    dataType: String
    physicalName: PHONETIC_FIRST_NAME
