    description: ''
    documentation: ''
    dataType: String
    physicalName: NORMALIZED_STREET
    mandatory: false
    mandatoryValidationLabel: ''
    valueSeparator: ','
    length: 128
  - _name: NormalizedCity
    _type: EntityAttribute
    label: Normalized City
    description: ''
    documentation: ''
    dataType: String
    physicalName: NORMALIZED_CITY
    mandatory: false
    mandatoryValidationLabel: ''
    valueSeparator: ','
    length: 128
  - _name: NormalizedState
    _type: EntityAttribute
    label: Normalized State
    description: ''
    documentation: ''
    dataType: String
    physicalName: NORMALIZED_STATE
    mandatory: false
    mandatoryValidationLabel: ''
    valueSeparator: ','
    length: 128
  - _name: SourceEmail
