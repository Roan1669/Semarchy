_package: CustomerB2C.entities.Person.business_views
_type: BusinessView
_name: ConfirmMatches
label: Confirm Matches
displayRootNodeAs: ICON_LABEL
enableHierarchyView: false
entity: CustomerB2C.entities.Person.Person
rootFilter: MastersCount > 1 AND ConfirmationStatus != 'CONFIRMED'
rootIconUrl: images://mdi/account-check.svg
rootDescription: ''
rootLabel: Confirm Match
rootPluralLabel: Confirm Matches
useHierarchyOnOpen: false

rootBusinessViewEntity:
  _name: Person
  _type: BusinessViewEntity
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig1
      _type: BusinessEntitySearchTypeConfig
      searchType: CUSTOM_FORM
      customForm: CustomerB2C.entities.Person.search_forms.PersonValueStatusSearchForm
    - _name: FormConfig2
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  actionSet: CustomerB2C.entities.Person.action_sets.PersonConfirmMatchesActionSet
  collection: CustomerB2C.entities.Person.collection_views.PersonConfirmMatchesCollection
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  entity: CustomerB2C.entities.Person.Person
  form: CustomerB2C.entities.Person.forms.PersonConfirmMatchesForm
  displayCard: CustomerB2C.entities.Person.display_cards.PersonDisplayCard
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: false
  tableAllowed: true
  transitions:
    - _name: MasterRecords
      _type: BusinessViewTransition
      transitionType: FULLY_QUALIFIED
      displayFormTabAs: ICON_LABEL
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      filter: 1 = 1
      iconUrl: images://mdi/puzzle.svg
      transitionPath: MasterRecords
      useCustomLabel: false
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: CustomerB2C.entities.Person.business_views.ConfirmMatches.Person
