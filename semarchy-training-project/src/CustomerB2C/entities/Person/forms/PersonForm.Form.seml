                              multilineMaxLines: '3'
                              multilineMinLines: '1'
                            labelProperties:
                              isVisible: '1'
                              alignment: right
                              position: left
                              typography: caption

                          - _type: TextField
                            _name: CleansedEmail
                            dataType: STRING
                            useCustomLabel: false
                            value: CleansedEmail
                            visibleValueInterpreter: LITERAL
                            visibleValue: '1'
                            authoringMode: auto
                            componentProperties:
                              textAlign: left
                              textTypography: body-1
                              multilineMaxLines: '3'
                              multilineMinLines: '1'
                            labelProperties:
                              isVisible: '1'
                              alignment: right
                              position: left
                              typography: caption

                          - _type: TextField
                            _name: ValidEmailDomain
                            label: Valid Email Domain
                            dataType: STRING
                            useCustomLabel: true
                            value: >
                              CASE   
                              WHEN ValidEmailDomain = '1' THEN 'YES'
                              ELSE 'NO'
                              END
                            visibleValueInterpreter: LITERAL
                            visibleValue: '1'
                            authoringMode: auto
                            componentProperties:
                              textAlign: left
                              textTypography: body-1
                              multilineMaxLines: '3'
                              multilineMinLines: '1'
                            labelProperties:
                              isVisible: '1'
                              alignment: right
                              position: left
                              typography: caption

                      - _type: FormContainer
                        _name: Container15
