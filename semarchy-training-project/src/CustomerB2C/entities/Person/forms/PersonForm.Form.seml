          - _type: FormContainer
            _name: Container7
            layoutDirection: COLUMN

            content:
              - _type: FormSection
                _name: EmailPhone
                label: Email & Phone
                layoutDirection: COLUMN
                visibleValueInterpreter: LITERAL
                visibleValue: '1'

                content:
                  - _type: FormContainer
                    _name: Container6
                    layoutDirection: COLUMN

                    content:
                      - _type: FormContainer
                        _name: Container16
                        layoutDirection: COLUMN
                      
                        content:
