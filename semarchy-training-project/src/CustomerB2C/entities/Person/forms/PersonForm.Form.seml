_package: CustomerB2C.entities.Person.forms
_type: Form
_name: PersonForm
default: true
entity: CustomerB2C.entities.Person.Person

formTabs:
  - _type: FormTab
    _name: Person
    label: Person
    iconUrl: images://mdi/account-outline.svg
    visibleValue: '1'
    displayFormTabAs: ICON_LABEL
    documentationInterpreter: LITERAL
    visibleValueInterpreter: LITERAL

    content:
      - _type: FormContainer
        _name: Container17
        layoutDirection: ROW

        content:
          - _type: FormSection
            _name: BasicInfo
            label: Basic Information
            layoutDirection: COLUMN
            visibleValue: '1'
            labelWidth: 120px
            visibleValueInterpreter: LITERAL

            content:
              - _type: IdField
                _name: ID
                dataType: LONG_INTEGER
                useCustomLabel: false
                value: ID
                visibleValueInterpreter: LITERAL
                visibleValue: '1'
                authoringMode: auto
                componentProperties:
                  textAlign: left
                  textTypography: body-1
                labelProperties:
                  isVisible: '1'
                  alignment: right
                  position: left
                  typography: caption

              - _type: TextField
                _name: FirstName
                dataType: STRING
                useCustomLabel: false
                value: FirstName
                authoringMode: auto
                visibleValueInterpreter: LITERAL
                visibleValue: '1'
                componentProperties:
                  textAlign: left
                  textTypography: body-1
                  multilineMaxLines: '3'
                  multilineMinLines: '1'
                labelProperties:
                  isVisible: '1'
                  alignment: right
                  position: left
                  typography: caption

              - _type: TextField
                _name: LastName
                dataType: STRING
                useCustomLabel: false
                value: LastName
                visibleValueInterpreter: LITERAL
                authoringMode: auto
                visibleValue: '1'
                componentProperties:
                  textAlign: left
                  textTypography: body-1
                  multilineMaxLines: '3'
                  multilineMinLines: '1'
                labelProperties:
                  isVisible: '1'
                  alignment: right
                  position: left
                  typography: caption

              - _type: TextField
                _name: DateOfBirth
                dataType: DATE
                useCustomLabel: false
                value: DateOfBirth
                visibleValueInterpreter: LITERAL
                authoringMode: auto
                visibleValue: '1'
                componentProperties:
                  textAlign: left
                  textTypography: body-1
                  multilineMaxLines: '3'
                  multilineMinLines: '1'
                labelProperties:
                  isVisible: '1'
                  alignment: right
                  position: left
                  typography: caption

              - _type: TextField
                _name: MemberID
                dataType: STRING
                useCustomLabel: false
                value: MemberID
                visibleValueInterpreter: LITERAL
                authoringMode: auto
                visibleValue: '1'
                componentProperties:
                  textAlign: left
                  textTypography: body-1
                  multilineMaxLines: '3'
                  multilineMinLines: '1'
                labelProperties:
                  isVisible: '1'
                  alignment: right
                  position: left
                  typography: caption

              - _type: MenuField
                _name: PersonType
                dataType: STRING
                useCustomLabel: false
                value: PersonType
                visibleValueInterpreter: LITERAL
                visibleValue: '1'
                authoringMode: auto
                componentProperties:
                  textAlign: left
                  textTypography: body-1
                  listSort: none
                labelProperties:
                  isVisible: '1'
                  alignment: right
                  position: left
                  typography: caption

              - _type: MenuField
                _name: ValueStatus
                dataType: STRING
                useCustomLabel: false
                value: ValueStatus
                visibleValueInterpreter: LITERAL
                authoringMode: auto
                visibleValue: '1'
                componentProperties:
                  textAlign: left
                  textTypography: body-1
                  listSort: none
                labelProperties:
                  isVisible: '1'
                  alignment: right
                  position: left
                  typography: caption

              - _type: TextField
                _name: ProductsPurchased
                dataType: STRING
                useCustomLabel: true
                label: Products Purchased
                value: |
                  LOOKUP
                    string_agg FDN_Product
                    separated by ', '
                    from PersonProducts
                    order by FDN_Product
                  END
                visibleValueInterpreter: LITERAL
                visibleValue: '1'
                authoringMode: auto
                componentProperties:
                  textAlign: left
                  textTypography: body-1
                  multilineMaxLines: '3'
                  multilineMinLines: '1'
                  isMultiline: '1'
                labelProperties:
                  isVisible: '1'
                  alignment: right
                  position: left
                  typography: caption

          - _type: FormSection
            _name: NameInfo
            label: Name Enrichment
            documentationInterpreter: LITERAL
            layoutDirection: COLUMN
            visibleValue: '1'
            labelWidth: 200px
            visibleValueInterpreter: LITERAL

            content:
              - _type: TextField
                _name: EnrichedName
                dataType: STRING
                useCustomLabel: true
                label: Enriched Names
                value: "'These values are used for helping match customers.'"
                visibleValueInterpreter: LITERAL
                visibleValue: '1'
                authoringMode: auto
                componentProperties:
                  textColor: md:grey
                  textTypography: body-1
                  multilineMaxLines: '3'
                  multilineMinLines: '1'
                labelProperties:
                  alignment: right
                  position: left
                  typography: caption

              - _type: TextField
                _name: PhoneticFirstName
                dataType: STRING
                useCustomLabel: false
                value: PhoneticFirstName
                visibleValueInterpreter: LITERAL
                visibleValue: '1'
                authoringMode: auto
                componentProperties:
                  textAlign: left
                  textTypography: body-1
                  multilineMaxLines: '3'
                  multilineMinLines: '1'
                labelProperties:
                  isVisible: '1'
                  alignment: right
                  position: left
                  typography: caption

              - _type: TextField
                _name: PhoneticLastName
                dataType: STRING
                useCustomLabel: false
                value: PhoneticLastName
                visibleValueInterpreter: LITERAL
                visibleValue: '1'
                authoringMode: auto
                componentProperties:
                  textAlign: left
                  textTypography: body-1
                  multilineMaxLines: '3'
                  multilineMinLines: '1'
                labelProperties:
                  isVisible: '1'
                  alignment: right
                  position: left
                  typography: caption

              - _type: TextField
                _name: NormalizedFirstName
                dataType: STRING
                useCustomLabel: false
                value: NormalizedFirstName
                visibleValueInterpreter: LITERAL
                visibleValue: '1'
                authoringMode: auto
                componentProperties:
                  textAlign: left
                  textTypography: body-1
                  multilineMaxLines: '3'
                  multilineMinLines: '1'
                labelProperties:
                  isVisible: '1'
                  alignment: right
                  position: left
                  typography: caption

              - _type: TextField
                _name: NormalizedLastName
                dataType: STRING
                useCustomLabel: false
                value: NormalizedLastName
                visibleValueInterpreter: LITERAL
                visibleValue: '1'
                authoringMode: auto
                componentProperties:
                  textAlign: left
                  textTypography: body-1
                  multilineMaxLines: '3'
                  multilineMinLines: '1'
                labelProperties:
                  isVisible: '1'
                  alignment: right
                  position: left
                  typography: caption

              - _type: TextField
                _name: Nickname
                dataType: STRING
                useCustomLabel: false
                value: Nickname
                visibleValueInterpreter: LITERAL
                visibleValue: '1'
                authoringMode: auto
                componentProperties:
                  textAlign: left
                  textTypography: body-1
                  multilineMaxLines: '3'
                  multilineMinLines: '1'
                labelProperties:
                  isVisible: '1'
                  alignment: right
                  position: left
                  typography: caption                

