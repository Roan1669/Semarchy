_package: CustomerB2C.entities.Person.survivorship_rules
_type: StandardSurvivorshipRule
_name: EmailRule
label: Email Rule
consolidationSkipNulls: false
defaultRule: false
entity: CustomerB2C.entities.Person.Person
attributes:
  - attributeName: CleansedEmail
  - attributeName: SourceEmail
  - attributeName: ValidEmailDomain
consolidationStrategy: PREFERRED_PUBLISHER
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: CustomerB2C.publishers.Marketing
  - _type: ConsoPublisherRanking
    publisher: CustomerB2C.publishers.ERP
  - _type: ConsoPublisherRanking
    publisher: CustomerB2C.publishers.CRM
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
