rootFilter: 1 = 1
rootIconUrl: images://mdi/ticket-account.svg
rootDescription: ''
rootLabel: Person Product
rootPluralLabel: Person Products
useHierarchyOnOpen: false

rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: PersonProductEO
  entity: CustomerB2C.entities.PersonProduct.PersonProduct
  collection: CustomerB2C.entities.PersonProduct.collection_views.PersonProductBrowseCollection
