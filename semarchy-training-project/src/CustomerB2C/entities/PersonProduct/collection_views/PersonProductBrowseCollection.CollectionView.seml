_package: CustomerB2C.entities.PersonProduct.collection_views
_type: CollectionView
_name: PersonProductBrowseCollection

default: true
entity: CustomerB2C.entities.PersonProduct.PersonProduct
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Person Product
tableRowLines: 2
tableShowDisplayCard: true
displayCard: CustomerB2C.entities.PersonProduct.display_cards.PersonProductDisplayCard

tableColumns:
  - _type: IdColumn
    _name: ID
    columnAlign: LEFT
    dataType: STRING
    documentationInterpreter: LITERAL
    useCustomLabel: true
    label: ID
    value: ID
    visibleByDefault: true

  - _type: ReferenceColumn
    _name: FDN_Person
    referencedEntity: CustomerB2C.entities.Person.Person
    columnAlign: LEFT
    dataType: STRING
    documentationInterpreter: LITERAL
    useCustomLabel: false
    value: FDN_Person
    visibleByDefault: true
    componentProperties:
      displayType: hyperlink
    
  - _type: ReferenceColumn
    _name: FDN_Product
    referencedEntity: CustomerB2C.entities.Product.Product
    columnAlign: LEFT
    dataType: STRING
    componentProperties:
      displayType: hyperlink
    documentationInterpreter: LITERAL
    useCustomLabel: false
    value: FDN_Product
    visibleByDefault: true

  - _type: TextColumn
    _name: PurchaseDate
    columnAlign: LEFT
    dataType: DATE
    documentationInterpreter: LITERAL
    useCustomLabel: false
    value: PurchaseDate
    visibleByDefault: true

  - _type: TextColumn
    _name: RegistrationDate
    columnAlign: LEFT
    dataType: DATE
    documentationInterpreter: LITERAL
    useCustomLabel: true
    label: Registration Date
    value: RegistrationDate
    visibleByDefault: true
