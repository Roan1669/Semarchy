      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
      enabled: false
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
      enabled: true
  actionSet: ProductRetail.entities.Brand.action_sets.BrandActionSet
  collection: ProductRetail.entities.Brand.collection_views.BrandCollection
