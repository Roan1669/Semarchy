_package: ProductRetail.entities.Brand.forms
_type: Form
_name: BrandEditingForm
default: false
entity: ProductRetail.entities.Brand.Brand

formTabs:
  - _type: FormTab
    _name: Brand
    label: Brand
    visibleValue: '1'
    displayFormTabAs: LABEL
    visibleValueInterpreter: LITERAL

    content:
      - _type: IdField
        _name: ID
        useCustomLabel: false
        value: ID
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        dataType: STRING
        authoringMode: auto
        componentProperties:
          textAlign: left
          textTypography: body-1
        labelProperties:
          isVisible: '1'
          alignment: right
          position: left
          typography: caption

      - _type: TextField
        _name: Name
        value: Name
        useCustomLabel: false
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        dataType: STRING
        authoringMode: auto
        componentProperties:
          textAlign: left
          textTypography: body-1
          multilineMaxLines: '3'
          multilineMinLines: '1'
        labelProperties:
          isVisible: '1'
          alignment: right
          position: left
          typography: caption
          
      - _type: ImageField
        _name: Logo
        value: LogoURL
        useCustomLabel: false
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        dataType: STRING
        authoringMode: auto
        componentProperties:
          textTypography: body-1
          imageHeight: '300'
          imageSourceType: url
          fallbackImageType: url
          showFullSizeOnClick: '1'
          imageAlign: top-left
          imageMode: fit
        labelProperties:
          isVisible: '0'
          alignment: right
          position: left
          typography: caption
