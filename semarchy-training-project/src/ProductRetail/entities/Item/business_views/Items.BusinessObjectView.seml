_package: ProductRetail.entities.Item.business_views
_type: BusinessView
_name: Items
label: Items
entity: ProductRetail.entities.Item.Item
description: ''
displayRootNodeAs: ICON_LABEL
enableHierarchyView: false
rootFilter: 1 = 1
rootIconUrl: images://mdi/basket-fill.svg
rootLabel: Item
rootPluralLabel: Items
useHierarchyOnOpen: false
rootDescription: ''
rootBusinessViewEntity:
  _name: Item
  _type: BusinessViewEntity
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: true
  sortExpression: Product.Name, Color, lpad(Size.SizeUS, 2, '0')
  tableAllowed: true
  actionSet: ProductRetail.entities.Item.action_sets.ItemActionsNoCreate
  collection: ProductRetail.entities.Item.collection_views.ItemCollection
  entity: ProductRetail.entities.Item.Item
  form: ProductRetail.entities.Item.forms.ItemBrowsingForm
  displayCard: ProductRetail.entities.Item.display_cards.ItemDisplayCard
  businessEntitySearchConfigs:
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
      enabled: true
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
      enabled: true
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
      enabled: true
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
      enabled: true
  referenceAttributeNavigationConfigs:
    - formField: ProductRetail.entities.Item.forms.ItemBrowsingForm.Item.Container27.Container37.FDN_Product
      navigationMode: BUSINESS_OBJECT_VIEW
      businessView: ProductRetail.entities.Product.business_views.Products
  transitions:
    - _name: Images
      _type: BusinessViewTransition
      description: ''
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      filter: 1 = 1
      iconUrl: images://mdi/folder-multiple-image.svg
      transitionPath: Images
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: false
      businessViewEntity:
        _name: ItemImage
        _type: BusinessViewEntity
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: false
        tableAllowed: true
        collection: ProductRetail.entities.ItemImage.collection_views.ItemImageCollection
        entity: ProductRetail.entities.ItemImage.ItemImage
        form: ProductRetail.entities.ItemImage.forms.ItemImageBrowsingForm
        displayCard: ProductRetail.entities.ItemImage.display_cards.ItemImageDisplayCard
        referenceAttributeNavigationConfigs:
          - formField: ProductRetail.entities.ItemImage.forms.ItemImageBrowsingForm.ItemImage.Container24.Container26.FDN_Item
            navigationMode: MODAL_FORM
            form: ProductRetail.entities.Item.forms.ItemBrowsingForm