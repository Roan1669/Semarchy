_package: ProductRetail.entities.Product.collection_views
_type: CollectionView
_name: ProductCollection

default: true
entity: ProductRetail.entities.Product.Product
gridAllowed: true
gridColumns: 6
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: false
tableAllowed: true
tableDisplayCardColumnLabel: Product
tableRowLines: 2
tableShowDisplayCard: true
displayCard: ProductRetail.entities.Product.display_cards.ProductDisplayCard

tableColumns:
  - _type: IdColumn
    _name: ID
    columnAlign: LEFT
    documentationInterpreter: LITERAL
    useCustomLabel: false
    value: ID
    dataType: LONG_INTEGER
    visibleByDefault: true

  - _type: TextColumn
    _name: Name
    columnAlign: LEFT
    documentationInterpreter: LITERAL
    useCustomLabel: false
    value: Name
    dataType: STRING
    visibleByDefault: true

  - _type: TextColumn
    _name: Description
    columnAlign: LEFT
    documentationInterpreter: LITERAL
    useCustomLabel: false
    value: Description
    dataType: STRING
    visibleByDefault: true

  - _type: ReferenceColumn
    _name: FDN_Family
    columnAlign: LEFT
    documentationInterpreter: LITERAL
    label: Family
    useCustomLabel: true
    value: FDN_Family
    dataType: STRING
    visibleByDefault: true
    referencedEntity: ProductRetail.entities.Family.Family
    componentProperties:
      displayType: hyperlink

  - _type: ReferenceColumn
