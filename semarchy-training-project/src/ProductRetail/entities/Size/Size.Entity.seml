  - _type: EntityAttribute
    _name: SizeEU
    label: Size (EU)
    length: 128
    mandatory: false
    mandatoryValidationLabel: ''
    multiValued: false
    physicalName: SIZE_EU
    searchable: true
    valueSeparator: ','
