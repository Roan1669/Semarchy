    searchable: false
  - _type: EntityAttribute
    _name: SizeUS
    label: Size (US)
    length: 128
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    mandatoryValidationLabel: ''
    physicalName: SIZE_US
    searchable: true
    valueSeparator: ','
