_package: ProductRetail.entities.Size
_type: Entity
_name: Size
label: Size
dataEntryAllowed: true
enableDelete: true
entityType: BASIC
historizeGolden: false
historizeMaster: false
iconUrl: images://mdi/format-size.svg
physicalTableName: SIZES
pluralLabel: Sizes

attributes:
  - _type: EntityAttribute
    _name: ID
    label: ID
    physicalName: ID
    dataType: String
    length: 128
    mandatory: true
