_package: ProductRetail.entities.Size.business_views
_type: BusinessView
_name: Sizes
entity: ProductRetail.entities.Size.Size
displayRootNodeAs: ICON_LABEL
enableHierarchyView: false
rootFilter: 1 = 1
rootIconUrl: images://mdi/format-size.svg
label: Size
rootLabel: Size
rootPluralLabel: Size
rootDescription: ''
useHierarchyOnOpen: false

rootBusinessViewEntity:
  entity: ProductRetail.entities.Size.Size
  _type: BusinessViewEntity
  _name: Size
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: true
  sortExpression: FDN_Family, lpad(SizeUS , 2, '0')
  tableAllowed: true
  actionSet: ProductRetail.entities.Size.action_sets.SizeActions
  collection: ProductRetail.entities.Size.collection_views.SizeCollection
  form: ProductRetail.entities.Size.forms.SizeForm
  displayCard: ProductRetail.entities.Size.display_cards.SizeDisplayCardMinimal
  businessEntitySearchConfigs:
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
      enabled: true
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
      enabled: true
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
      enabled: true
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
      enabled: true
  referenceAttributeNavigationConfigs:
    - formField: ProductRetail.entities.Size.forms.SizeForm.Size.FDN_Family
      form: ProductRetail.entities.Family.forms.FamilyBrowsingForm
      navigationMode: MODAL_FORM
